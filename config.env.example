# Quadri Music Studio settings. The installer copies this file to config.env; edit config.env, not this one.
# Relative paths are relative to this folder. Environment variables override the values here.
# Restart the studio after changes.

# ---------- web UI ----------
# 0.0.0.0 makes the studio reachable from your LAN. There is no login: anyone on the network could use it.
#STUDIO_HOST=127.0.0.1
#STUDIO_PORT=8096
# songs (audio, scores, metadata)
#STUDIO_DATA=data

# ---------- YuE2 (song model, PyTorch) ----------
# Folder with YuE2-3B/ and YuE2-Vae/. Set it before installing to download there.
#YUE2_MODELS=models
# Python environment with PyTorch + yue2-infer (created by the installer)
#YUE2_VENV=runtime/venv
# Attention in the decode loop: auto (YuE2's FlashAttention, NVIDIA default), fast (AMD default), sdpa
#YUE2_ATTENTION=
# Don't load YuE2 with less free RAM than this (GB). It takes ~10 GB while singing.
#YUE2_MIN_FREE_GB=12

# ---------- lyrics writer (Simple mode, "Write with AI") ----------
# Any OpenAI-compatible chat API, base URL without /v1. By default the studio starts its own llama-server
# (installed by the installer) on this port when a song needs lyrics, and stops it before YuE2 sings.
# To use a server of your own, point LLM_URL at it and set LLM_SERVER= (empty), e.g.
#   Ollama: LLM_URL=http://127.0.0.1:11434 and LLM_MODEL=gemma3:12b
#   LM Studio: LLM_URL=http://127.0.0.1:1234
#LLM_URL=http://127.0.0.1:8097
# model name sent with requests (default: the first one the server lists)
#LLM_MODEL=
#LLM_API_KEY=
# the studio's own llama-server and its model (empty LLM_SERVER = never start one)
#LLM_SERVER=runtime/llama.cpp/llama-server
# (the installer's --small-lyrics-llm sets models/lyrics/gemma-4-E4B-it-Q4_K_M.gguf)
#LLM_GGUF=models/lyrics/Gemma4-26B-A4B-QAT-Uncensored-HauhauCS-Balanced-Q4_K_M.gguf
# Extra llama-server flags. With several GPUs, pick one with e.g. --device Vulkan1 (llama-server --list-devices).
#LLM_ARGS=
# Alternative: POST here when nothing answers at LLM_URL, to have something else load a model there
# (e.g. a local model manager). Headers as "Name: value", comma separated.
#LLM_START_URL=
#LLM_START_HEADERS=

# ---------- sharing the GPU with other local apps ----------
# A ComfyUI on the same GPU (e.g. Quadri Image Studio's): YuE2 waits while it renders and asks it to unload
# its models first. Empty = don't talk to ComfyUI.
#COMFY_URL=http://127.0.0.1:8188
#CONTAINER_CLI=podman
# Containers that hold VRAM, stopped before YuE2 loads: name, or name@composeDir (then `compose down` there).
#STOP_CONTAINERS=
# Apps asked to unload their models before YuE2 loads (POST, header X-Studio: 1; 409 = busy, the song waits).
# This studio answers the same way at POST /api/free, so other apps can ask it to unload YuE2.
#FREE_URLS=

# ---------- written by the installer ----------
